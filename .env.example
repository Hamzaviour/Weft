# Required in production: 32+ random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEFT_SECRET=

APP_URL=http://localhost:3000

# Optional: turns on the AI story writer (Vercel AI Gateway). Without it, the template writer is used.
AI_GATEWAY_API_KEY=
WEFT_MODEL=anthropic/claude-sonnet-5-5

# OAuth apps. Redirect URI for each: {APP_URL}/api/auth/{google|spotify|github|oura}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
